<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/b">

    <!-- Blue Blob Background - Left Side -->
    <View
        android:id="@+id/blobBg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="-160dp"
        android:background="@drawable/bg_circal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="1.15" />

    <!-- Soft Glow -->
    <View
        android:id="@+id/blobGlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="-130dp"
        android:background="@drawable/bg_glow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="1.3" />

    <!-- Main Content - On Top of Blue Blob -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_bias="0.12"
        android:layout_marginStart="40dp">

        <!-- Logo Card - b on f = perfect contrast -->
        <!-- Logo Card - FIXED CENTER -->
        <androidx.cardview.widget.CardView
            android:id="@+id/logoCard"
            android:layout_width="108dp"
            android:layout_height="108dp"
            app:cardBackgroundColor="@color/b"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="88dp"
                android:layout_height="88dp"

                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sola" />

        </androidx.cardview.widget.CardView>
        <!-- App Name - b on f -->
        <TextView
            android:id="@+id/appName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/aigd"
            android:text="Sola"
            android:textColor="@color/b"
            android:textSize="44sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <!-- Line - b on f -->
        <View
            android:id="@+id/lineView"
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="@color/b"
            android:alpha="0.9" />

        <!-- Tagline - b on f -->
        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.95"
            android:fontFamily="@font/aigd"
            android:text="Fast. Private. Yours."
            android:textColor="@color/b"
            android:textSize="15sp" />

        <!-- Progress - b on f -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginTop="30dp"
            android:indeterminateTint="@color/b" />

    </LinearLayout>

    <!-- Bottom Branding - f on b = perfect contrast -->
    <TextView
        android:id="@+id/awanIgdText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.7"
        android:fontFamily="@font/aigd"
        android:letterSpacing="0.18"
        android:text="Awan IGD"
        android:textColor="@color/f"
        android:textSize="12sp"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>