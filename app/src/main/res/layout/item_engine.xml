<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/b"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#1A4285F4"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Icon - Left Side Blue Filled -->
        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/engineIcon"
                android:layout_width="50dp"

                android:layout_height="50dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sola"
                 />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="246dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/engineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aigd"
                android:text="Google"
                android:textColor="@color/t"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:alpha="0.45"
                android:fontFamily="@font/aigd"
                android:text="Fast &amp; Private Search"
                android:textColor="@color/t"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Selected - Right Side -->
        <FrameLayout
            android:id="@+id/selectedIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_filled"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="@color/b" />
        </FrameLayout>

        <!-- Unselected Circle -->
        <View
            android:id="@+id/unselectedCircle"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_outline" />

    </LinearLayout>
</androidx.cardview.widget.CardView>